WealthSeiFacade
--
-transactions: TransactionService
-plans: PlanService
-budgets: BudgetService
-analytics: AnalyticsService
-goals: GoalService
-proposals: ProposalService
-reviews: ReviewService
-reports: ReportService
-agent: AgentController
--
+importTransactions(file: Path,
   today: LocalDate) ImportResult
+addTransaction(entry: NewTransaction) Transaction
+correctCategory(txId: String, category: Category) Transaction
+getPlan() FinancialPlan
+savePlan(plan: FinancialPlan) FinancialPlan
+setBudget(month: YearMonth, limits: BudgetLimits) BudgetStatus
+getBudgetStatus(month: YearMonth) BudgetStatus
+recurringPayments(asOf: LocalDate) RecurringReport
+getSafeToSpend(today: LocalDate) SafeToSpendResult
+getHabits(month: YearMonth) List&lt;Insight&gt;
+getHealthScore(month: YearMonth,
   today: LocalDate) HealthScore
+canIAfford(item: String, price: Money,
   date: LocalDate) AgentResult
+addGoal(request: GoalRequest,
   today: LocalDate) SavingsGoal
+getGoalFeasibility(idOrPrefix: String,
   today: LocalDate) FeasibilityReport
+proposeGoalFix(idOrPrefix: String,
   today: LocalDate) List&lt;Proposal&gt;
+runWhatIf(description: String) AgentResult
+generateMonthlyReview(month: YearMonth) MonthlyReview
+ask(question: String) AgentResult
+getTrace(traceId: String) AgentTrace
+createProposals(drafts: List&lt;ProposalDraft&gt;, traceId: String) List&lt;Proposal&gt;
+listPendingProposals(today: LocalDate) List&lt;Proposal&gt;
+decideProposal(idOrPrefix: String,
   approve: boolean) Proposal
+exportReport(month: YearMonth,
   format: ExportFormat, out: Path,
   overwrite: boolean) Path
+setProtectedCategory(category: Category,
   isProtected: boolean)
+addAlertListener(listener: AlertListener)
